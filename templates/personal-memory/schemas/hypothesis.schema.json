{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Profile Hypothesis",
  "type": "object",
  "required": ["hypothesis_id", "claim", "state", "confidence", "scope", "supporting_evidence_ids", "refuting_evidence_ids", "last_reviewed_at"],
  "properties": {
    "hypothesis_id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "state": {"enum": ["candidate", "active_hypothesis", "confirmed_principle", "retired"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "refuting_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "last_reviewed_at": {"type": "string", "format": "date-time"},
    "proposed_behavior_change": {"type": ["string", "null"]},
    "uncertainty": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
